# ==========================================================
# Chapter 3 complete handler coverage
# ==========================================================

def test_chapter_3_handler_coverage():
    """Chapter 3 must be completely covered by handlers."""

    handlers = load_handlers()

    lessons = handlers.MANAGEMENT_CHAPTER_LESSONS[
        CHAPTER_ID
    ]

    assert len(lessons) == 7

    for index, lesson in enumerate(
        lessons
    ):
        assert lesson["id"] in (
            handlers.MANAGEMENT_LESSONS
        )

        loaded_lesson = handlers.get_management_lesson(
            CHAPTER_ID,
            index,
        )

        assert loaded_lesson is lesson

        location = handlers.get_lesson_location(
            lesson["id"]
        )

        assert location == (
            CHAPTER_ID,
            index,
        )
